{
  "name": "stream-verde",
  "productName": "Stream Verde",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "author": "PlayFlix",
  "description": "Aplicativo de streaming Stream Verde para Windows",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "dist": "node compilador.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/lodash": "^4.17.24",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.1",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.7.13",
    "autoprefixer": "^10.4.21",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.streamverde.app",
    "productName": "Stream Verde",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "main-preload.cjs",
      "iframe-preload.cjs",
      "package.json",
      "icon.ico",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "StreamVerde-Setup.exe"
    }
  }
}